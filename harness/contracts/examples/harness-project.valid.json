{
  "schema_version": 1,
  "harness_version": "2.0.0",
  "project": {
    "id": "sample-service",
    "name": "Sample Service",
    "description": "Exemplo válido de manifesto"
  },
  "runtimes": ["codex", "claude-code"],
  "capabilities": {
    "git_delivery": true
  },
  "standards": {
    "baseline": ["software-engineering-lifecycle"],
    "activated": ["java-standard"]
  },
  "quality": {
    "commands": {
      "backend_test": "mvn test"
    }
  },
  "security": {
    "validators": [
      "mvn org.owasp:dependency-check-maven:check"
    ]
  },
  "paths": {
    "backend": ["backend/"],
    "docs": ["docs/"]
  }
}
