{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-design-docs.internal/contracts/handoff.schema.json",
  "title": "Handoff",
  "description": "Contrato estruturado para transição e handoff entre orquestrador, capacidades e gates.",
  "type": "object",
  "required": [
    "handoff_id",
    "task_id",
    "from",
    "to",
    "status",
    "handoff_at"
  ],
  "properties": {
    "handoff_id": {
      "type": "string",
      "description": "Identificador do handoff."
    },
    "task_id": {
      "type": "string",
      "description": "Identificador da tarefa."
    },
    "from": {
      "type": "string",
      "description": "Origem (agente ou capacidade)."
    },
    "to": {
      "type": "string",
      "description": "Destino (capacidade ou orquestrador)."
    },
    "status": {
      "type": "string",
      "enum": ["READY", "PASS", "FAIL", "BLOCKED", "COMPLETED"],
      "description": "Estado resultante transmitido."
    },
    "cause": {
      "type": "string",
      "description": "Motivo da falha ou bloqueio, se aplicável."
    },
    "next_owner": {
      "type": "string",
      "description": "Responsável pela próxima ação."
    },
    "resume_condition": {
      "type": "string",
      "description": "Condição para retomar a execução após BLOCKED."
    },
    "artifacts_changed": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Arquivos modificados ou gerados."
    },
    "evidence_refs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Evidências anexadas ao handoff."
    },
    "commands_executed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "command": { "type": "string" },
          "exit_code": { "type": "integer" }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "pending_items": {
      "type": "array",
      "items": { "type": "string" }
    },
    "handoff_at": {
      "type": "string",
      "description": "Timestamp ISO-8601."
    }
  },
  "additionalProperties": false
}
