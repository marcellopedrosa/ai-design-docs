{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-design-docs.internal/contracts/readiness-result.schema.json",
  "title": "ReadinessResult",
  "description": "Contrato formal de saída do Implementation Readiness Gate (READY ou BLOCKED).",
  "type": "object",
  "required": [
    "task_id",
    "decision",
    "scope",
    "owner",
    "audited_at"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "description": "Identificador da tarefa auditada."
    },
    "decision": {
      "type": "string",
      "enum": ["READY", "BLOCKED"],
      "description": "Decisão do gate. Não existe READY WITH ASSUMPTIONS."
    },
    "scope": {
      "type": "object",
      "required": ["paths", "fingerprint"],
      "properties": {
        "paths": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "fingerprint": {
          "type": "string",
          "description": "Hash SHA-256 ou identificador de versão do escopo auditado."
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version", "status"],
        "properties": {
          "id": { "type": "string" },
          "version": { "type": "string" },
          "status": { "type": "string" }
        },
        "additionalProperties": false
      },
      "description": "Fontes canônicas auditadas (PRD, REQ, ADR, contratos)."
    },
    "standards": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Standards ativados para a tarefa."
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "cause", "owner", "resume_when"],
        "properties": {
          "id": { "type": "string" },
          "cause": { "type": "string" },
          "owner": { "type": "string" },
          "resume_when": { "type": "string" }
        },
        "additionalProperties": false
      },
      "description": "Itens bloqueantes (obrigatório se decision for BLOCKED)."
    },
    "decomposition": {
      "type": "object",
      "properties": {
        "recommended": { "type": "boolean" },
        "children": {
          "type": "array",
          "items": { "type": "string" }
        },
        "rationale": { "type": "string" }
      },
      "description": "Recomendação de decomposição semântica caso a tarefa não seja atômica."
    },
    "owner": {
      "type": "string",
      "description": "Owner do gate (ex: Arquitetura, Produto e Qualidade)."
    },
    "audited_at": {
      "type": "string",
      "description": "Timestamp ISO-8601 da auditoria."
    }
  },
  "additionalProperties": false
}
