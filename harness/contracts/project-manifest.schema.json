{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProjectManifest",
  "description": "Contexto do projeto para resolução de profiles; não contém decisões técnicas locais.",
  "type": "object",
  "required": ["version", "project", "profiles", "agents"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "enum": [1] },
    "project": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
        "type": { "type": "string", "enum": ["application", "service", "library", "tooling", "infrastructure", "mobile", "other"] }
      }
    },
    "profiles": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" }
    },
    "agents": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" }
    },
    "metadata": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "owner": { "type": "string", "minLength": 1 }
      }
    },
    "onboarding": {
      "type": "object",
      "required": ["status", "questionnaire_version", "completed_on"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["completed"] },
        "questionnaire_version": { "type": "integer", "enum": [2] },
        "completed_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    }
  }
}
