{
  "name": "hub-contabil-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/with-local-contact-env.mjs",
    "dev:check": "node scripts/with-local-contact-env.mjs --check",
    "build": "next build --webpack",
    "build:html": "NEXT_STATIC_HTML_EXPORT=1 next build --webpack",
    "start": "next start --port 3002",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && npm run test:local-env",
    "test:local-env": "node --test scripts/*.test.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@next/env": "16.3.0",
    "lucide-react": "^1.7.0",
    "next": "16.3.0",
    "next-intl": "^4.13.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.55.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.17",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^9.36.0",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
