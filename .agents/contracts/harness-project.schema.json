{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-design-docs.internal/contracts/harness-project.schema.json",
  "title": "HarnessProjectManifest",
  "description": "Contrato estruturado para o manifesto de configuração do projeto adotante (harness.project.yaml).",
  "type": "object",
  "required": [
    "schema_version",
    "harness_version",
    "project"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "description": "Versão do schema do manifesto de projeto."
    },
    "harness_version": {
      "type": "string",
      "description": "Versão do AI Engineering Harness adotada."
    },
    "project": {
      "type": "object",
      "required": ["id", "name", "description"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "runtimes": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Lista de runtimes suportados no projeto adotante."
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      },
      "description": "Capacidades ou skills opt-in habilitadas no projeto."
    },
    "standards": {
      "type": "object",
      "properties": {
        "baseline": {
          "type": "array",
          "items": { "type": "string" }
        },
        "activated": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "quality": {
      "type": "object",
      "properties": {
        "commands": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "security": {
      "type": "object",
      "properties": {
        "validators": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "paths": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    }
  },
  "additionalProperties": false
}
