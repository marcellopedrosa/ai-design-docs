{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProfileRegistry",
  "description": "Artefatos exigidos por contexto sem definir seu conteúdo final.",
  "type": "object",
  "required": ["version", "profiles"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "enum": [1] },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["artifacts"],
        "additionalProperties": false,
        "properties": {
          "extends": {
            "type": "array", "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" }
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "name"],
              "additionalProperties": false,
              "properties": {
                "type": { "type": "string", "enum": ["agent", "standard", "architecture", "requirement"] },
                "scope": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
                "name": { "type": "string", "pattern": "^(?:[a-z][a-z0-9]*(?:-[a-z0-9]+)*|REQ-[0-9]{5}-[a-z0-9]+(?:-[a-z0-9]+)*)$" }
              }
            }
          }
        }
      }
    }
  }
}
