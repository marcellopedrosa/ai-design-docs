{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-design-docs.internal/contracts/capability-request.schema.json",
  "title": "CapabilityRequest",
  "description": "Contrato estruturado para solicitação de execução de uma capacidade ou skill.",
  "type": "object",
  "required": [
    "task_id",
    "capability",
    "scope"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "description": "Identificador da tarefa (ex: TASK-123 ou TP-00001)."
    },
    "capability": {
      "type": "string",
      "description": "Nome da capacidade ou skill solicitada (conforme registry/skills.yaml)."
    },
    "execution_level": {
      "type": "string",
      "enum": ["focused", "pr", "release"],
      "default": "focused",
      "description": "Nível de rigor da execução."
    },
    "readiness_ref": {
      "type": "object",
      "properties": {
        "task_id": { "type": "string" },
        "fingerprint": { "type": "string" },
        "audited_at": { "type": "string" }
      },
      "description": "Referência ao resultado READY vigente."
    },
    "scope": {
      "type": "object",
      "required": ["paths"],
      "properties": {
        "paths": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "fingerprint": {
          "type": "string",
          "description": "Hash ou identificador de estado do escopo auditado."
        }
      }
    },
    "active_standards": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Standards ativados para esta execução."
    },
    "parameters": {
      "type": "object",
      "additionalProperties": true,
      "description": "Parâmetros adicionais específicos da capacidade."
    }
  },
  "additionalProperties": false
}
