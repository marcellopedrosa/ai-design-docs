{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ai-design-docs.internal/contracts/doctor-result.schema.json",
  "title": "DoctorResult",
  "description": "Contrato estruturado para saída JSON do harness-doctor (--json).",
  "type": "object",
  "required": [
    "status",
    "checks"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["PASS", "FAIL"],
      "description": "Resultado geral consolidado do diagnóstico do harness."
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status",
          "errors"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Nome da verificação estrutural."
          },
          "status": {
            "type": "string",
            "enum": ["PASS", "FAIL"],
            "description": "Status da verificação."
          },
          "detail": {
            "type": "string",
            "description": "Detalhes de contexto ou contagem da verificação."
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Lista de mensagens de erro encontradas."
          }
        },
        "additionalProperties": false
      },
      "description": "Lista de verificações estruturais realizadas pelo harness doctor."
    }
  },
  "additionalProperties": false
}
